<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.godev.optistock">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Permet à la version Pro et à la version Essai de se détecter mutuellement sur Android 11+ -->
    <queries>
        <package android:name="com.godev.optistock.trial" />
        <package android:name="com.godev.optistock.pro" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/splash_logo"
        android:roundIcon="@drawable/splash_logo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pont automatique de transfert des données et photos de la version Essai vers la version Pro -->
        <provider
            android:name=".MigrationProvider"
            android:authorities="${applicationId}.provider"
            android:exported="true" />
    </application>
</manifest>
