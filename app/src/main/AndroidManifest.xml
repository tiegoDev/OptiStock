<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.godev.optistock">

    <!-- Permission personnalisée verrouillée par certificat (seules les apps signées avec optistock.keystore y ont accès) -->
    <permission
        android:name="com.godev.optistock.permission.MIGRATE_DATA"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.godev.optistock.permission.MIGRATE_DATA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <queries>
        <package android:name="com.godev.optistock.trial" />
        <package android:name="com.godev.optistock.pro" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/splash_logo"
        android:roundIcon="@drawable/splash_logo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pont de migration protégé par la permission signature -->
        <provider
            android:name=".MigrationProvider"
            android:authorities="${applicationId}.provider"
            android:exported="true"
            android:readPermission="com.godev.optistock.permission.MIGRATE_DATA" />
    </application>
</manifest>
